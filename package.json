{
  "name": "realm-studio-plus",
  "productName": "Realm Studio Plus",
  "version": "20.0.0",
  "description": "A tool for everything Realm!",
  "author": {
    "name": "Realm",
    "email": "info@realm.io",
    "url": "https://realm.io"
  },
  "repository": "https://github.com/jooy2/realm-studio-plus",
  "license": "Apache-2.0",
  "main": "./build/main.bundle.js",
  "build": {
    "appId": "com.mongodb.realm-studio",
    "directories": {
      "buildResources": "./resources"
    },
    "files": [
      "./build/**/*",
      "./node_modules/**/*",
      "./package.json",
      "./static/**/*",
      "!node_modules/realm/android${/*}",
      "!node_modules/realm/react-native${/*}",
      "!node_modules/realm/scripts${/*}",
      "!node_modules/realm/src${/*}",
      "!node_modules/realm/vendor${/*}"
    ],
    "asarUnpack": [
      "./node_modules/realm/binding/build/realm.node"
    ],
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "category": "public.app-category.developer-tools",
      "binaries": [
        "dist/mac/Realm Studio.app/Contents/Resources/app.asar.unpacked/node_modules/realm/binding/build/realm.node"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "iconSize": 90,
      "contents": [
        {
          "x": 95,
          "y": 200
        },
        {
          "x": 430,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "perMachine": true
    },
    "protocols": [
      {
        "name": "Realm Studio",
        "schemes": [
          "x-realm-cloud",
          "x-realm-studio"
        ]
      }
    ],
    "fileAssociations": {
      "ext": "realm",
      "name": "Realm",
      "isPackage": true
    },
    "publish": [
      {
        "provider": "s3",
        "bucket": "static.realm.io",
        "region": "us-east-1",
        "path": "downloads/realm-studio",
        "channel": "major-15"
      }
    ],
    "npmArgs": [
      "--fallback-to-build=false"
    ]
  },
  "scripts": {
    "build": "webpack --mode production --config=configs/webpack.js",
    "check:package-lock": "node ./scripts/check-package-lock.js",
    "dev:ros-https": "ros start --https --https-key ./data/keys/server.key --https-cert ./data/keys/server.crt",
    "dev:ros-unreliable": "node ./scripts/unreliable-ros.js",
    "dev:ros": "ros start",
    "dev:debug": "REALM_STUDIO_DEV_TOOLS=true npm run dev",
    "predev": "lsof -ti:8080 | xargs kill -9 2>/dev/null || true",
    "dev": "rm -rf ./build && concurrently --kill-others --names \"WEBPACK:M,WEBPACK:R,ELECTRON\" \"npm run webpack:main\" \"npm run webpack:renderer\" \"npm run wait-for-bundle && ELECTRON_ENABLE_LOGGING=1 electron .\"",
    "lint": "eslint . --ext .js,.ts,.tsx,.jsx --fix . && sass-lint --max-warnings=0 -c .sass-lint.yml 'src/**/*.scss' -v",
    "format": "prettier . --write",
    "package": "electron-builder --publish=never",
    "postinstall": "electron-builder install-app-deps",
    "prepackage": "rm -rf ./build && npm run build",
    "generate-https-certificate": "openssl req -x509 -newkey rsa:4096 -keyout data/keys/server.key -out data/keys/server.crt -days 365 -nodes",
    "generate-all-types-realm": "node ./scripts/generate-realm.js",
    "start": "electron .",
    "sentry:upload-symbols": "node ./scripts/sentry-symbols.js",
    "test": "mochapack --mode development --webpack-config configs/webpack.test.js 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "test:post-package": "mochapack --mode development --webpack-config configs/webpack.test.js src/testing/post-packaging/index.ts",
    "wait-for-bundle": "node ./scripts/wait-for-bundle.js",
    "webpack:main": "webpack --mode development --config configs/webpack.main.js",
    "webpack:renderer": "webpack serve --mode development --config configs/webpack.renderer.js",
    "notarize": "node ./scripts/notarize"
  },
  "dependencies": {
    "@contentful/rich-text-html-renderer": "16.3.5",
    "@contentful/rich-text-types": "16.3.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron/remote": "^2.1.3",
    "@sentry/electron": "^7.13.0",
    "classnames": "^2.5.1",
    "contentful": "^11.12.2",
    "electron-store": "^11.0.2",
    "electron-updater": "6.8.3",
    "flatted": "^3.4.2",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.3.5",
    "isomorphic-fetch": "^3.0.0",
    "json5": "^2.2.3",
    "memoize-one": "^6.0.0",
    "mixpanel-browser": "^2.79.0",
    "mochapack": "^2.1.5",
    "moment": "^2.30.1",
    "papaparse": "^5.5.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-draggable": "^4.5.0",
    "react-virtualized": "^9.22.6",
    "reactstrap": "^9.2.3",
    "realm": "^20.2.0",
    "semver": "^7.8.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@octokit/rest": "^22.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@sentry/cli": "^3.4.3",
    "@sentry/webpack-plugin": "^5.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/isomorphic-fetch": "0.0.39",
    "@types/jsdom": "^28.0.3",
    "@types/mixpanel": "^2.14.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/react-virtualized": "^9.22.3",
    "@types/semver": "^7.7.1",
    "@types/source-map-support": "^0.5.10",
    "@types/tmp": "^0.2.6",
    "@types/uuid": "^11.0.0",
    "@types/webpack": "^5.28.5",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/parser": "^8.60.0",
    "bootstrap": "^5.3.8",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "electron": "41.7.1",
    "electron-builder": "^26.8.1",
    "electron-download": "^4.1.1",
    "electron-notarize": "^1.2.2",
    "electron-publisher-s3": "^20.17.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "faker": "^6.6.6",
    "file-loader": "^6.2.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.6",
    "mocha-github-actions-reporter": "^0.3.1",
    "mocha-junit-reporter": "^2.2.1",
    "null-loader": "^4.0.1",
    "prettier": "^3.8.3",
    "react-refresh": "^0.18.0",
    "remark": "^15.0.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.100.0",
    "sass-lint": "^1.13.1",
    "sass-loader": "^17.0.0",
    "simple-git": "^3.36.0",
    "source-map-support": "^0.5.21",
    "style-loader": "^4.0.0",
    "svg-sprite-loader": "^6.0.11",
    "tmp": "^0.2.6",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "webpack-visualizer-plugin": "^0.1.11",
    "why-did-you-update": "^1.0.8",
    "xvfb-maybe": "^0.2.1"
  },
  "engines": {
    "node": "^22"
  }
}
